# Recode IT — frontend environment variables
#
# Copy to `.env.local` (gitignored) and edit. All VITE_-prefixed vars are
# inlined at build time and become visible in the client bundle, so never put
# secrets here.

# ---------------------------------------------------------------------------
# NER ONNX model URL (DistilBERT Italian, token-classification)
# ---------------------------------------------------------------------------
# When unset, the runner picks:
#   - dev   → /models/distilbert_italian_ner_q8.onnx  (Vite serves public/)
#   - prod  → https://mhc.micheleloi.pro/recode-it/models/distilbert_italian_ner_q8.onnx
# Override here for staging URLs, mirror hosts, or local prod-bundle testing.
VITE_NER_MODEL_URL=https://mhc.micheleloi.pro/recode-it/models/distilbert_italian_ner_q8.onnx
