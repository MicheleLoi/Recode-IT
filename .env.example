# Recode IT — frontend environment variables
#
# Copy to `.env.local` (gitignored) and edit. All VITE_-prefixed vars are
# inlined at build time and become visible in the client bundle, so never put
# secrets here.

# ---------------------------------------------------------------------------
# GLiNER ONNX model URL
# ---------------------------------------------------------------------------
# When unset, the runner picks:
#   - dev   → /models/gliner_multi_v2.1_q8.onnx  (Vite serves from public/)
#   - prod  → https://mhc.micheleloi.pro/recode-it/models/gliner_multi_v2.1_q8.onnx
# Override here for staging URLs, mirror hosts, or local prod-bundle testing.
VITE_GLINER_MODEL_URL=https://mhc.micheleloi.pro/recode-it/models/gliner_multi_v2.1_q8.onnx
