{
  "name": "recode-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-side pseudonymization for Italian legal documents — TypeScript port of the validated MHC-L pipeline.",
  "license": "AGPL-3.0-or-later",
  "author": "Michele Loi <mhcl@micheleloi.pro>",
  "homepage": "https://recode.micheleloi.pro/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MicheleLoi/Recode-IT.git"
  },
  "bugs": {
    "url": "https://github.com/MicheleLoi/Recode-IT/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@noble/hashes": "1.5.0",
    "@xenova/transformers": "^2.17.2",
    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.13.3",
    "mammoth": "^1.12.0",
    "onnxruntime-web": "^1.26.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
