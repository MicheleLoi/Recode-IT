# DEV-ONLY: mock mode environment — loaded by `npm run dev:mock` (vite --mode mock).
# This file lives only on branch mock/e2e-test-build — never commit to main.
#
# Activates MockAuthProvider: user is always logged in, Decodifica always
# unlocked via mhc_bearer. All other code runs real production logic.
#
# IMPORTANT: VITE_ prefix required for Vite to expose this to import.meta.env.
# This file does NOT carry any real secrets — the mock bypasses auth entirely.
VITE_MOCK_FULL=1
